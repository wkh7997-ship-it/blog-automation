# 이 파일을 .env 로 복사해서 실제 값을 채워 넣으세요.  (cp .env.example .env)
# 따옴표 없이 = 뒤에 바로 값을 붙여 쓰면 됩니다.

# Anthropic API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Pixabay API 키 (https://pixabay.com/api/docs/ → 가입·로그인하면 문서 페이지에 키가 표시됨)
PIXABAY_API_KEY=

# 티스토리 Access Token / 블로그 이름 (xxx.tistory.com 의 xxx 부분)
TISTORY_ACCESS_TOKEN=
TISTORY_BLOG_NAME=

# ── 선택 항목 ──
# 사용할 Claude 모델 (미지정 시 claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# 티스토리 공개 설정: 0=비공개(초안 용도, 기본), 1=보호, 3=발행
# TISTORY_VISIBILITY=0
# 티스토리 카테고리 ID (미지정 시 기본 카테고리)
# TISTORY_CATEGORY_ID=
